# Met Opera for webOS (unofficial) - local configuration.
# Copy to `.env` (same folder, repo root) and replace every CHANGE_ME. `.env` is git-ignored: never commit it.
# app/build.js reads this file at build time (esbuild `define`); the Worker deploy scripts, telemetry/query.sh,
# telemetry/test_e2e.sh and app/tools/upload-thumbs.js read it too. Check it any time with: node scripts/env.js

# ---- App build -------------------------------------------------------------------------------------------
# REQUIRED. https URL of your Cloudflare Worker (telemetry/worker/worker.js). It serves the generated
# thumbnails, pop-up facts and (optionally) telemetry. No trailing slash needed.
MTV_WORKER_URL=https://CHANGE_ME.CHANGE_ME.workers.dev

# OPTIONAL. Telemetry ingest key = the Worker secret INGEST_KEY (24+ chars, e.g. `openssl rand -hex 24`).
# It is compiled into the app (low-security: it only deters noise). Leave it empty or CHANGE_ME to build
# WITHOUT telemetry: events and problem reports are compiled into no-ops and nothing is ever sent.
MTV_TELEMETRY_INGEST_KEY=CHANGE_ME

# ---- Operations only (never compiled into the app) --------------------------------------------------------
# Worker secret READ_TOKEN (32+ chars): Bearer token for telemetry/query.sh, test_e2e.sh and thumbnail uploads.
MTV_TELEMETRY_READ_TOKEN=CHANGE_ME
# Cloudflare account id (32 hex chars; dashboard sidebar). Used by deploy tooling only.
CF_ACCOUNT_ID=CHANGE_ME
# Worker script name and D1 database (free tier is enough).
CF_WORKER_NAME=met-tv-telemetry
CF_D1_DATABASE_NAME=met-tv-telemetry
# D1 database id (UUID) from `wrangler d1 list` or the dashboard.
CF_D1_DATABASE_ID=CHANGE_ME
